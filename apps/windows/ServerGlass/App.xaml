<Application
    x:Class="ServerGlass.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <!--
        Dark only, deliberately. The palette in Theme.cs is the same one the Apple and Android apps
        use, and a light variant would be a fifth design nobody has drawn. Someone moving between
        their phone and their desk should see the same dashboard.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
