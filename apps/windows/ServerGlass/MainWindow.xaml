<Window
    x:Class="ServerGlass.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Sidebar and detail, which is the macOS navigation from DESIGN.md and the right shape for a
        desktop. The panes do not collapse by width here: a desktop window that narrow is a window
        someone is resizing past, not a device class.
    -->
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid x:Name="Sidebar" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="AppTitle"
                       Grid.Row="0"
                       Margin="16,14,16,10"
                       Text="ServerGlass"
                       FontSize="15"
                       FontWeight="SemiBold" />

            <!-- Built in code rather than templated: each row watches its own host and repaints
                 only the dot and the two lines of text, which is cheaper and clearer than a
                 converter chain, and keeps the status colour coming from the core's level. -->
            <ScrollViewer Grid.Row="1" Margin="6,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="HostItems" Spacing="2" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="12" Spacing="6">
                <Button x:Name="AddButton"
                        HorizontalAlignment="Stretch"
                        Content="Add a server"
                        Click="OnAddServer" />
                <Button x:Name="PairButton"
                        HorizontalAlignment="Stretch"
                        Content="Copy servers from a phone"
                        Click="OnPair" />
            </StackPanel>
        </Grid>

        <!-- Detail -->
        <Grid x:Name="Detail" Grid.Column="1" />
    </Grid>
</Window>
