<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon. The launcher masks the foreground to whatever shape the device uses — circle,
  squircle, teardrop — so the glyph is drawn inset into the safe zone and the background is a flat
  colour rather than part of the artwork.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
