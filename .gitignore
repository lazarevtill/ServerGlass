# Build output
/target
.build/
apps/macos/.swiftpm/
# The Linux app is its own cargo workspace, so it has its own target directory. Its Cargo.lock is
# committed on purpose — CI builds it with --locked.
apps/linux/target/

# Generated by uniffi-bindgen at build time — never edit or commit.
apps/macos/Sources/ServerGlassFFI/generated/

# Throwaway SSH key for the local test containers. Regenerated by fixtures/up.sh.
# It authenticates a disposable loopback-only container, but a private key in a repo trips
# every secret scanner and teaches the wrong habit.
fixtures/id_test
fixtures/id_test.pub

.DS_Store

# Generated by XcodeGen from apps/ios/project.yml; never edit or commit.
apps/ios/ServerGlass.xcodeproj/
apps/ios/Info.plist

# Android build output and generated bindings.
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
apps/android/app/src/main/jniLibs/

# Windows app build output. The generated C# bindings under
# apps/windows/ServerGlass.Core/Generated/ are committed on purpose, exactly as the Swift ones are,
# so a checkout builds without running a generator first; scripts/check-bindings.ps1 proves they
# are current.
apps/windows/**/bin/
apps/windows/**/obj/

# Release artefacts and the local Android signing key. The key identifies this build machine and
# must never be committed; scripts/release.sh regenerates it if absent.
/dist/
/release/
