# BusyBox target. Exercises the parser paths where `df`, `ps` and `ls` differ from GNU.
FROM alpine:3.20

RUN apk add --no-cache openssh-server \
    && mkdir -p /root/.ssh \
    && chmod 700 /root/.ssh

COPY id_test.pub /root/.ssh/authorized_keys
RUN chmod 600 /root/.ssh/authorized_keys

RUN sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config \
    && sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config \
    # See Dockerfile.debian: the parallel test suite exceeds the stock connection limits.
    && printf 'MaxStartups 200:30:400\nMaxSessions 200\n' >> /etc/ssh/sshd_config \
    && ssh-keygen -A

EXPOSE 22
CMD ["sh", "-c", "mkdir -p /run/sshd && exec /usr/sbin/sshd -D -e"]
